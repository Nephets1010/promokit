<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.nephets</groupId>
    <artifactId>promokit</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>promokit-contract</artifactId>
  <name>promokit-contract</name>
  <description>公共契约：promokit 全家族共享的异常体系与状态枚举。零第三方依赖，任何模块（含外部集成方）都可以单独依赖它。</description>

  <!--
    ★ 本模块刻意保持零依赖（含构建期）：异常与枚举是所有模块的公共词汇表，
      一旦它反向依赖任何模块就会形成环，下游也无法在裁剪掉 core/rules 后单独复用。
  -->
  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>

  <properties>
    <jacoco.report.skip>false</jacoco.report.skip>
  </properties>
</project>
